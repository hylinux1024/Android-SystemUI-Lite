<resources>
    <!--
      Uses the platform-agnostic system status_bar_height. Marked with the
      @*android: star-import so the linker resolves it against the device
      framework at runtime (it is a public framework dimension, safe to star).
    -->
    <dimen name="status_bar_height">@*android:dimen/status_bar_height</dimen>

    <!-- Status-bar milestone (Phase 3). Values mirror AOSP SystemUI dimens. -->
    <dimen name="status_bar_icon_size">@*android:dimen/status_bar_system_icon_size</dimen>
    <dimen name="status_bar_wifi_signal_size">@*android:dimen/status_bar_system_icon_size</dimen>
    <dimen name="status_bar_padding_start">8dp</dimen>
    <dimen name="status_bar_padding_end">8dp</dimen>
    <dimen name="status_bar_padding_top">0dp</dimen>
    <dimen name="status_bar_clock_size">14sp</dimen>
    <dimen name="status_bar_battery_icon_height">13dp</dimen>
    <dimen name="status_bar_battery_icon_width">7.8dp</dimen>
    <dimen name="status_bar_horizontal_padding">2.5dp</dimen>
    <dimen name="status_bar_clock_starting_padding">0dp</dimen>
    <dimen name="status_bar_clock_end_padding">0dp</dimen>
    <dimen name="signal_icon_size_roaming">16dp</dimen>

    <!-- Shade panel milestone (Phase 4). Mirrors AOSP SystemUI dimens. -->
    <dimen name="notification_panel_margin_horizontal">16dp</dimen>
    <dimen name="shade_open_spring_out_duration">350</dimen>
    <dimen name="shade_close_duration">300</dimen>
    <dimen name="lights_in_duration">250</dimen>
    <dimen name="lights_out_duration">1500</dimen>
    <dimen name="background_duration">200</dimen>

    <!-- Edge-swipe-back gesture (Phase 4 — navigation). Mirrors AOSP SystemUI dimens. -->
    <dimen name="edge_back_panel_width">48dp</dimen>
    <dimen name="edge_back_edge_width">16dp</dimen>
    <dimen name="edge_back_bottom_gesture_height">24dp</dimen>
</resources>
