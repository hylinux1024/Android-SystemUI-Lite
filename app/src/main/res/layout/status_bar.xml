<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar root layout. Mirrors AOSP SystemUI PhoneStatusBarView /
  status_bar.xml structure: start side (clock + notification icons) / cutout
  spacer / end side (system icons). Root is a transparent horizontal LinearLayout.
  Height is resolved from the framework's status_bar_height at inflation time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/status_bar_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingStart="@dimen/status_bar_padding_start"
    android:paddingEnd="@dimen/status_bar_padding_end"
    android:paddingTop="@dimen/status_bar_padding_top"
    android:focusable="false"
    android:clipChildren="false">

    <!-- START side: clock + notification icon area. -->
    <FrameLayout
        android:id="@+id/status_bar_start_side_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/status_bar_start_side_content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="none"
                android:gravity="center|start"
                android:paddingStart="@dimen/status_bar_clock_starting_padding"
                android:paddingEnd="@dimen/status_bar_clock_end_padding"
                android:textAppearance="@style/TextAppearance.StatusBar.Clock" />

            <LinearLayout
                android:id="@+id/notification_icon_area"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false" />

        </LinearLayout>

    </FrameLayout>

    <!-- Center cutout spacer. Hidden until the display-cutout inset listener
         sizes it for the notch-bearing rotation. Mirrors AOSP cutout_space_view. -->
    <Space
        android:id="@+id/cutout_space_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- END side: system_icons (signal + wifi + battery). -->
    <FrameLayout
        android:id="@+id/status_bar_end_side_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/status_bar_end_side_content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:clipChildren="false">

            <include layout="@layout/system_icons" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
