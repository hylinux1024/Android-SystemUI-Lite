<?xml version="1.0" encoding="utf-8"?>
<!-- QS tile — matches AOSP QSTileViewImpl horizontal layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qs_tile"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/qs_tile_background"
    android:paddingStart="@dimen/qs_tile_start_padding"
    android:paddingEnd="@dimen/qs_tile_padding"
    android:paddingTop="@dimen/qs_tile_padding"
    android:paddingBottom="@dimen/qs_tile_padding"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="@dimen/qs_tile_margin_vertical_half"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="@dimen/qs_icon_size"
        android:layout_height="@dimen/qs_icon_size"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="1"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.QS.TileLabel"
        android:layout_marginStart="@dimen/qs_label_container_margin" />

</LinearLayout>
